<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ims.ui.controllers.AdminController" spacing="15">

    <Label text="Admin Control Panel — User Management &amp; System Logs" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <!-- User Creation Form -->
    <VBox spacing="10" style="-fx-border-color: #2980b9; -fx-padding: 12; -fx-border-radius: 5; -fx-background-color: #f8f9f9;">
        <Label text="Create New User Account" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="userNameInput" promptText="Full Name / Username" HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="userRoleCombo" promptText="Select Role"/>
            <PasswordField fx:id="userPasswordInput" promptText="Password"/>
            <TextField fx:id="commissionInput" promptText="Commission Rate (e.g. 0.05)"/>
            <Button text="Add User" onAction="#handleCreateUser" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
        <Label fx:id="statusLabel" style="-fx-font-weight: bold;"/>
    </VBox>

    <Label text="Existing System Users" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
    
    <!-- User Management Table -->
    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="userIdCol" text="User ID" prefWidth="80"/>
            <TableColumn fx:id="nameCol" text="Username" prefWidth="200"/>
            <TableColumn fx:id="roleCol" text="Role" prefWidth="150"/>
            <TableColumn fx:id="passwordCol" text="Password" prefWidth="150"/>
            <TableColumn fx:id="commissionCol" text="Commission Rate" prefWidth="150"/>
        </columns>
    </TableView>
</VBox>