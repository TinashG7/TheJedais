<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainLayout" prefHeight="600.0" prefWidth="900.0" 
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.ims.ui.controllers.DashboardController">
    
    <!-- Top Bar: Navigation, Status Alert & User Actions -->
    <top>
        <VBox spacing="5" style="-fx-background-color: #2c3e50; -fx-padding: 10;">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="Joshua's Shop IMS" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                
                <HBox spacing="10" HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT">
                    <Button text="Inventory" onAction="#showInventoryView" style="-fx-background-color: #34495e; -fx-text-fill: white;"/>
                    <Button text="Sales" onAction="#showSalesView" style="-fx-background-color: #34495e; -fx-text-fill: white;"/>
                    <Button text="Stock Orders" onAction="#showOrdersView" style="-fx-background-color: #34495e; -fx-text-fill: white;"/>
                    
                    <!-- Session & Account Switch Buttons -->
                    <Button text="Switch User" onAction="#handleSwitchUser" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Button text="Log Out" onAction="#handleLogout" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>
            </HBox>

            <!-- Quick Status Alert Banner -->
            <HBox fx:id="alertBanner" alignment="CENTER_LEFT" spacing="10" 
                  style="-fx-background-color: #e74c3c; -fx-padding: 8; -fx-background-radius: 4;" visible="false">
                <Label fx:id="alertLabel" text="Warning: Low stock items detected!" 
                       style="-fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </top>

    <!-- Center Content Area: Dynamic View Loading -->
    <center>
        <VBox fx:id="contentArea" alignment="CENTER" spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
        </VBox>
    </center>
</BorderPane>