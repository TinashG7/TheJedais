<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ims.ui.controllers.InventoryListController" spacing="10">
    
    <!-- Search and Filter Bar -->
    <HBox spacing="10">
        <TextField fx:id="searchField" promptText="Search items..." HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="categoryFilterCombo" promptText="Select Category"/>
        <Button text="Search" onAction="#handleSearch"/>
    </HBox>

    <!-- Table View -->
    <TableView fx:id="itemsTable">
        <columns>
            <!-- Added -->
            <TableColumn fx:id="itemIdColumn" text="ID"/>
            <!-- End of added -->
            <TableColumn fx:id="nameColumn" text="Name"/>
            <TableColumn fx:id="categoryColumn" text="Category"/>
            <TableColumn fx:id="priceColumn" text="Price"/>
            <TableColumn fx:id="quantityColumn" text="Quantity"/>
        </columns>
    </TableView>

    <!-- Added -->
    <!-- Add Item Form -->
    <VBox spacing="5" style="-fx-border-color: lightgray; -fx-padding: 10; -fx-border-radius: 5;">
        <Label text="Add New Item" style="-fx-font-weight: bold;"/>
        <HBox spacing="10">
            <TextField fx:id="nameInput" promptText="Item Name" HBox.hgrow="ALWAYS"/>
            <TextField fx:id="categoryInput" promptText="Category"/>
            <TextField fx:id="priceInput" promptText="Selling Price"/>
            <TextField fx:id="costPriceInput" promptText="Cost Price"/>
            <TextField fx:id="quantityInput" promptText="Quantity"/>
            <TextField fx:id="thresholdInput" promptText="Low Threshold"/>
            <Button text="Add Item" onAction="#handleAddItem"/>
        </HBox>
    </VBox>
    <!-- End of added -->
</VBox>