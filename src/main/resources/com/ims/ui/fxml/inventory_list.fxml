<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ims.ui.controllers.InventoryListController" spacing="10">
    
    <!-- Search and Filter Bar -->
    <HBox spacing="10">
        <TextField fx:id="searchField" promptText="Search items..." HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="categoryFilterCombo" promptText="Select Category"/>
        <Button text="Search" onAction="#handleSearch"/>
    </HBox>

    <!-- Table View -->
    <TableView fx:id="itemsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="itemIdColumn" text="ID" prefWidth="60"/>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="280"/>
            <TableColumn fx:id="categoryColumn" text="Category" prefWidth="150"/>
            <TableColumn fx:id="priceColumn" text="Price" prefWidth="100"/>
            <TableColumn fx:id="quantityColumn" text="Quantity" prefWidth="100"/>
        </columns>
    </TableView>

    <!-- Add Item Form -->
    <VBox spacing="5" style="-fx-border-color: lightgray; -fx-padding: 10; -fx-border-radius: 5;">
        <Label text="Add New Item" style="-fx-font-weight: bold;"/>
        <HBox spacing="10">
            <TextField fx:id="nameInput" promptText="Item Name" prefWidth="250" HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="categoryInputCombo" promptText="Select Category"/>
            <TextField fx:id="priceInput" promptText="Selling Price" prefWidth="90"/>
            <TextField fx:id="costPriceInput" promptText="Cost Price" prefWidth="90"/>
            <TextField fx:id="quantityInput" promptText="Quantity" prefWidth="80"/>
            <TextField fx:id="thresholdInput" promptText="Low Threshold" prefWidth="100"/>
            <Button text="Add Item" onAction="#handleAddItem"/>
        </HBox>
    </VBox>
</VBox>