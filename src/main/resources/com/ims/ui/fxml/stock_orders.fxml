<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ims.ui.controllers.StockOrdersController" spacing="10">
    
    <Label text="Log Incoming Restock Order" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <!-- Status Message Banner for UI Alerts -->
    <Label fx:id="statusMessageLabel" style="-fx-font-weight: bold;"/>

    <!-- Restock Order Form -->
    <VBox spacing="10" style="-fx-border-color: lightgray; -fx-padding: 10; -fx-border-radius: 5;">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <ComboBox fx:id="itemComboBox" promptText="Select Item to Restock" HBox.hgrow="ALWAYS"/>
            <TextField fx:id="unitCostField" promptText="Unit Cost Price (KSh)"/>
            <TextField fx:id="quantityField" promptText="Quantity Received"/>
            <TextField fx:id="expenseField" promptText="Total Expense (KSh)"/>
            <Button text="Record Order" onAction="#handleRecordOrder"/>
        </HBox>
        <HBox spacing="10">
            <Label fx:id="sellingPriceLabel" text="Current Selling Price: KSh 0.00" style="-fx-text-fill: gray;"/>
        </HBox>
    </VBox>

    <Label text="Stock Orders History" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

    <!-- Orders History Table -->
    <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="orderIdColumn" text="Order ID"/>
            <TableColumn fx:id="itemIdColumn" text="Item ID"/>
            <TableColumn fx:id="quantityColumn" text="Quantity Received"/>
            <TableColumn fx:id="expenseColumn" text="Expense Amount"/>
            <TableColumn fx:id="dateColumn" text="Order Date"/>
        </columns>
    </TableView>
</VBox>