<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ims.ui.controllers.RecordSaleController"
      spacing="14" alignment="CENTER" prefWidth="360">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Record Sale" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="12">
        <Label text="Item:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="itemComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="200"/>

        <Label text="Quantity:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Spinner fx:id="quantitySpinner" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="120"/>
    </GridPane>

       <Label fx:id="totalPriceLabel" text="Total: 0.00"/>

    <HBox spacing="10" alignment="CENTER">
    <Button fx:id="confirmButton" text="Confirm Sale"/>
    <Button fx:id="cancelButton" text="Cancel"/>
</HBox>
</VBox>